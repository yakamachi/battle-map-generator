{
  "openapi": "3.1.1",
  "info": {
    "title": "BattleMapGenerator.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/maps/generate": {
      "post": {
        "tags": [
          "MapEndpoints"
        ],
        "operationId": "GenerateMap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/GenerateMapRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedMap"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BossSize": {
        "enum": [
          "large",
          "huge",
          "gargantuan",
          null
        ]
      },
      "CellKind": {
        "enum": [
          "void",
          "floor",
          "corridor",
          "wall",
          "door",
          "bossArena"
        ]
      },
      "EncounterType": {
        "enum": [
          "skirmish",
          "boss"
        ]
      },
      "GeneratedMap": {
        "required": [
          "seed",
          "parameters",
          "width",
          "height",
          "cells",
          "rooms"
        ],
        "type": "object",
        "properties": {
          "seed": {
            "type": "integer",
            "format": "uint32"
          },
          "parameters": {
            "$ref": "#/components/schemas/MapParameters"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellKind"
            }
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Room"
            }
          }
        }
      },
      "GenerateMapRequest": {
        "required": [
          "seed"
        ],
        "type": "object",
        "properties": {
          "seed": {
            "type": [
              "null",
              "integer"
            ],
            "format": "uint32"
          },
          "roomCount": {
            "maximum": 12,
            "minimum": 2,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "encounter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EncounterType"
              }
            ]
          },
          "bossSize": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BossSize"
              }
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MapParameters": {
        "required": [
          "roomCount",
          "encounter",
          "bossSize"
        ],
        "type": "object",
        "properties": {
          "roomCount": {
            "type": "integer",
            "format": "int32"
          },
          "encounter": {
            "$ref": "#/components/schemas/EncounterType"
          },
          "bossSize": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BossSize"
              }
            ]
          }
        }
      },
      "Room": {
        "required": [
          "x",
          "y",
          "width",
          "height",
          "kind"
        ],
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "format": "int32"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/RoomKind"
          }
        }
      },
      "RoomKind": {
        "enum": [
          "room",
          "bossArena"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "MapEndpoints"
    }
  ]
}