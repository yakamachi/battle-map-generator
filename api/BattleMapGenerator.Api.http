@HostAddress = http://localhost:5108
# Local-only key from appsettings.Development.json.
@health_ready_key = local-dev-only-ready-key

GET {{HostAddress}}/api/health/live
Accept: application/json

###

GET {{HostAddress}}/api/health/ready
Accept: application/json
X-Health-Key: {{health_ready_key}}

###

# Public and rate-limited (10 per minute per client IP). Omit the body or the seed for a random map.
POST {{HostAddress}}/api/maps/generate
Content-Type: application/json
Accept: application/json

{
  "seed": 42
}

###

# Auth needs the local database (docker compose up -d, then dotnet ef database update --project api).
# Register and login share 10 calls per minute per client IP. Both answer with the session cookie,
# which the client keeps for the requests below.
@email = dm@example.com
@password = local-dev-password

POST {{HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

POST {{HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# 200 with the account's email while logged in, 401 otherwise.
GET {{HostAddress}}/api/auth/me
Accept: application/json

###

# 204, also when no one is logged in.
POST {{HostAddress}}/api/auth/logout

###
